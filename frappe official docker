#################### Frappe version-12 ###################
pyenv install 3.7
PYENV_VERSION=3.7 pip install --no-cache-dir virtualenv
pyenv global 3.7

nvm install 10
nvm use 10
npm install -g yarn

nvm use v10
PYENV_VERSION=3.7 bench init --skip-redis-config-generation --frappe-branch version-12 frappe-bench-v12

Note: Change Common Site Config 
{
  "background_workers": 1,
  "file_watcher_port": 6787,
  "frappe_user": "frappe",
  "gunicorn_workers": 33,
  "live_reload": true,
  "rebase_on_pull": false,
  "redis_cache": "redis://v11-redis-cache-1:6379",	# Need to Change
  "redis_queue": "redis://v11-redis-queue-1:6379",	# Need to Change
  "redis_socketio": "redis://v11-redis-queue-1:6379",	# Need to change
  "restart_supervisor_on_update": false,
  "restart_systemd_on_update": false,			
  "serve_default_site": true,
  "shallow_clone": true,
  "socketio_port": 9000,
  "use_redis_auth": false,
  "webserver_port": 8000,
  "db_host": "{{frappe_docker_mariadb_container_name}}"				# Add This new line
}


bench new-site site-v12.local --db-host v11-mariadb-1
bench use site-v12.local


bench restore {_db_file_} --force
	Note: keep the db file in bench directory

bench migrate --skip-failing

bench backup --with-files


