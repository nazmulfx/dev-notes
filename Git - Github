⭐ Full Guide: Personal + Official GitHub on One PC

1️⃣ Create Two SSH Keys
    ssh-keygen -t ed25519 -C "nazmulhossain664@gmail.com" -f ~/.ssh/id_ed25519_personal
    ssh-keygen -t ed25519 -C "nazmul@invento.com.bd" -f ~/.ssh/id_ed25519_official


2️⃣ Add Both Keys to SSH Agent
    eval "$(ssh-agent -s)"

    ssh-add ~/.ssh/id_ed25519_personal
    ssh-add ~/.ssh/id_ed25519_official

3️⃣ Add Public Keys to GitHub
    cat ~/.ssh/id_ed25519_personal.pub

    cat ~/.ssh/id_ed25519_official.pub

4️⃣ Create SSH Config File
    4️⃣ Create SSH Config File

"""
# Personal GitHub
Host github.com-personal
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal

# Official GitHub
Host github.com-official
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_official

"""

5️⃣ Cloning Repositories
    git clone git@github.com-personal:YOUR_PERSONAL_USERNAME/REPO.git
    git clone git@github.com-official:YOUR_OFFICIAL_USERNAME/REPO.git


6️⃣ Verify Everything Works
    ssh -T git@github.com-personal
    ssh -T git@github.com-official
